<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Escape the Train - Puzzle</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Special+Elite&display=swap');

        :root {
            --bg-color: #d1cbc1; /* Колір старого паперу */
            --text-color: #1a1a1a;
            --highlight: rgba(76, 175, 80, 0.5); /* Підсвітка правильного місця */
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            background-image: url('https://www.transparenttextures.com/patterns/crumpled-paper.png');
            font-family: 'Special Elite', monospace;
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
            touch-action: pan-x pan-y; /* Дозволяє зум і скрол сторінки */
        }

        header {
            width: 100%;
            padding: 20px;
            text-align: center;
            min-height: 80px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        #help-btn {
            font-family: 'Special Elite', monospace;
            font-size: 1.5rem;
            padding: 10px 30px;
            background-color: #333;
            color: #fff;
            border: 2px solid #000;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s;
            box-shadow: 3px 3px 0px #000;
        }

        #help-btn:hover {
            background-color: #555;
        }

        #win-text {
            font-size: 1.5rem;
            text-align: center;
            display: none;
            margin: 0;
            text-shadow: 1px 1px 2px rgba(255,255,255,0.5);
        }

        #game-area {
            position: relative;
            width: 95vw;
            max-width: 600px;
            /* Пропорція пазлу (5 колонок x 6 рядків). Приблизно 5:6 */
            aspect-ratio: 5 / 6; 
            margin-bottom: 200px; /* Місце для розкиданих шматочків знизу */
        }

        #board {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            grid-template-rows: repeat(6, 1fr);
            border: 3px solid #333;
            background: rgba(255, 255, 255, 0.2);
            box-shadow: inset 0 0 20px rgba(0,0,0,0.1);
        }

        .cell {
            border: 1px dashed rgba(0, 0, 0, 0.3);
            box-sizing: border-box;
            transition: background 0.2s;
        }

        .cell.highlight {
            background-color: var(--highlight);
        }

        #hint-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s;
            z-index: 5;
        }

        #hint-img.visible {
            opacity: 0.4;
        }

        #full-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            opacity: 0;
            pointer-events: none;
            transition: opacity 1s;
            z-index: 20;
            border: 3px solid #333;
        }

        #full-img.visible {
            opacity: 1;
        }

        .piece {
            position: absolute;
            width: calc(100% / 5); /* 1/5 ширини поля */
            height: calc(100% / 6); /* 1/6 висоти поля */
            background-size: 500% 600%; /* Розтягуємо фон, щоб відображалась потрібна частина */
            cursor: grab;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.5);
            z-index: 50;
            touch-action: none; /* Запобігає скролу при тягненні шматочка */
            transition: transform 0.1s, box-shadow 0.1s;
        }

        .piece:active {
            cursor: grabbing;
            box-shadow: 4px 4px 10px rgba(0,0,0,0.6);
            transform: scale(1.05);
        }

        .piece.locked {
            z-index: 2 !important; /* На задній план */
            pointer-events: none;
            box-shadow: none;
            border: none;
            transform: scale(1);
        }

        /* Салют */
        canvas#fireworks {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 9999;
        }

        /* Приховати сітку при перемозі */
        .hide-grid {
            border: none !important;
            box-shadow: none !important;
        }
        .hide-grid .cell {
            border: none !important;
        }
    </style>
</head>
<body>

    <header>
        <button id="help-btn">HELP</button>
        <h1 id="win-text">Choose one of Escape Hatchways and make your move</h1>
    </header>

    <div id="game-area">
        <img id="hint-img" src="https://ludasolutions.github.io/EscapeCodes/Train/fullmap.jpg" alt="Hint">
        <div id="board">
            </div>
        <img id="full-img" src="https://ludasolutions.github.io/EscapeCodes/Train/fullmap.jpg" alt="Full Map">
        
        </div>

    <canvas id="fireworks"></canvas>

    <script>
        const BASE_URL = "https://ludasolutions.github.io/EscapeCodes/Train/";
        const EXTENSION = ".jpg"; // Змініть на .png, якщо файли у вас збережені як png
        const COLS = 5;
        const ROWS = 6;
        const TOTAL_PIECES = COLS * ROWS;
        
        const board = document.getElementById('board');
        const gameArea = document.getElementById('game-area');
        const helpBtn = document.getElementById('help-btn');
        const hintImg = document.getElementById('hint-img');
        const winText = document.getElementById('win-text');
        const fullImg = document.getElementById('full-img');
        
        let lockedCount = 0;
        let pieces = [];
        let cells = [];
        
        // Ініціалізація гри
        function initGame() {
            createBoard();
            createPieces();
        }

        function createBoard() {
            for (let r = 1; r <= ROWS; r++) {
                for (let c = 1; c <= COLS; c++) {
                    let cell = document.createElement('div');
                    cell.className = 'cell';
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    board.appendChild(cell);
                    cells.push(cell);
                }
            }
        }

        function createPieces() {
            for (let r = 1; r <= ROWS; r++) {
                for (let c = 1; c <= COLS; c++) {
                    let piece = document.createElement('div');
                    piece.className = 'piece';
                    piece.dataset.row = r;
                    piece.dataset.col = c;
                    
                    // Завантажуємо зображення
                    const bgUrl = `${BASE_URL}row-${r}-column-${c}${EXTENSION}`;
                    piece.style.backgroundImage = `url(${bgUrl})`;
                    piece.style.backgroundSize = '100% 100%';
                    
                    // Рандомна позиція внизу (під полем)
                    randomizePosition(piece);
                    
                    gameArea.appendChild(piece);
                    pieces.push(piece);
                    makeDraggable(piece);
                }
            }
        }

        function randomizePosition(piece) {
            // Розміщуємо шматочки під полем (margin-bottom: 200px у game-area)
            const areaWidth = gameArea.offsetWidth;
            const areaHeight = gameArea.offsetHeight;
            const pieceWidth = areaWidth / COLS;
            const pieceHeight = areaHeight / ROWS;
            
            const maxLeft = areaWidth - pieceWidth;
            // Розташування під дошкою
            const minTop = areaHeight + 20; 
            const maxTop = areaHeight + 150; 

            piece.style.left = Math.random() * maxLeft + 'px';
            piece.style.top = (minTop + Math.random() * (maxTop - minTop)) + 'px';
        }

        // Логіка Drag and Drop (працює на мишці та сенсорах)
        function makeDraggable(piece) {
            let startX, startY, startLeft, startTop;
            let currentCell = null;

            piece.addEventListener('pointerdown', (e) => {
                if (piece.classList.contains('locked')) return;
                
                // Переносимо на передній план
                pieces.forEach(p => { if (!p.classList.contains('locked')) p.style.zIndex = 50; });
                piece.style.zIndex = 100;

                startX = e.clientX;
                startY = e.clientY;
                startLeft = parseFloat(piece.style.left) || 0;
                startTop = parseFloat(piece.style.top) || 0;
                
                piece.setPointerCapture(e.pointerId);

                piece.onpointermove = (ev) => {
                    let dx = ev.clientX - startX;
                    let dy = ev.clientY - startY;
                    
                    let newLeft = startLeft + dx;
                    let newTop = startTop + dy;

                    // Обмеження: не виходити за рамки екрану (body)
                    const pieceRect = piece.getBoundingClientRect();
                    const bodyRect = document.body.getBoundingClientRect();
                    
                    // Обчислення центру шматочка для підсвітки клітинок
                    const pieceCenterX = pieceRect.left + pieceRect.width / 2;
                    const pieceCenterY = pieceRect.top + pieceRect.height / 2;

                    piece.style.left = newLeft + 'px';
                    piece.style.top = newTop + 'px';

                    // Перевірка, над якою клітинкою знаходимось
                    let target = getCellUnderPoint(pieceCenterX, pieceCenterY);
                    
                    if (currentCell && currentCell !== target) {
                        currentCell.classList.remove('highlight');
                    }
                    if (target) {
                        target.classList.add('highlight');
                        currentCell = target;
                    } else {
                        currentCell = null;
                    }
                };

                piece.onpointerup = (ev) => {
                    piece.onpointermove = null;
                    piece.onpointerup = null;
                    piece.releasePointerCapture(e.pointerId);

                    if (currentCell) {
                        currentCell.classList.remove('highlight');
                        
                        // Перевіряємо чи правильна клітинка
                        if (currentCell.dataset.row === piece.dataset.row && 
                            currentCell.dataset.col === piece.dataset.col) {
                            
                            // Зафіксувати
                            snapPiece(piece, currentCell);
                        }
                    }
                };
            });
        }

        function getCellUnderPoint(x, y) {
            for (let cell of cells) {
                const rect = cell.getBoundingClientRect();
                if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
                    return cell;
                }
            }
            return null;
        }

        function snapPiece(piece, cell) {
            // Вираховуємо відносні координати відносно game-area
            const cellWidth = gameArea.offsetWidth / COLS;
            const cellHeight = gameArea.offsetHeight / ROWS;
            
            const colIdx = parseInt(cell.dataset.col) - 1;
            const rowIdx = parseInt(cell.dataset.row) - 1;

            piece.style.left = (colIdx * cellWidth) + 'px';
            piece.style.top = (rowIdx * cellHeight) + 'px';
            piece.style.width = cellWidth + 'px';
            piece.style.height = cellHeight + 'px';
            
            piece.classList.add('locked');
            
            // Легке підсвічування зеленим на мить
            piece.style.filter = 'brightness(1.5) sepia(1) hue-rotate(90deg) saturate(3)';
            setTimeout(() => { piece.style.filter = 'none'; }, 300);

            lockedCount++;
            checkWin();
        }

        // Кнопка Help
        helpBtn.addEventListener('click', () => {
            hintImg.classList.add('visible');
            setTimeout(() => {
                hintImg.classList.remove('visible');
            }, 3000); // Зникає через 3 секунди
        });

        // Перевірка перемоги
        function checkWin() {
            if (lockedCount === TOTAL_PIECES) {
                setTimeout(() => {
                    board.classList.add('hide-grid');
                    helpBtn.style.display = 'none';
                    winText.style.display = 'block';
                    fullImg.classList.add('visible');
                    pieces.forEach(p => p.style.opacity = '0'); // Ховаємо окремі шматочки
                    startFireworks();
                }, 500);
            }
        }

        // --- ПРОСТА АНІМАЦІЯ САЛЮТУ ---
        const canvas = document.getElementById('fireworks');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        let particles = [];

        function startFireworks() {
            createExplosion(canvas.width / 2, canvas.height / 2);
            createExplosion(canvas.width / 4, canvas.height / 3);
            createExplosion(canvas.width * 0.75, canvas.height / 3);
            animateFireworks();
        }

        function createExplosion(x, y) {
            for (let i = 0; i < 100; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.5) * 10,
                    size: Math.random() * 4 + 1,
                    color: `hsl(${Math.random() * 360}, 100%, 50%)`,
                    alpha: 1,
                    decay: Math.random() * 0.015 + 0.01
                });
            }
        }

        function animateFireworks() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < particles.length; i++) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.1; // Гравітація
                p.alpha -= p.decay;
                
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
            }
            particles = particles.filter(p => p.alpha > 0);
            
            if (particles.length > 0) {
                requestAnimationFrame(animateFireworks);
            } else {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
        }

        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            // Перемальовка зафіксованих шматочків при зміні розміру екрану
            const cellWidth = gameArea.offsetWidth / COLS;
            const cellHeight = gameArea.offsetHeight / ROWS;
            pieces.forEach(piece => {
                if(piece.classList.contains('locked')) {
                    const colIdx = parseInt(piece.dataset.col) - 1;
                    const rowIdx = parseInt(piece.dataset.row) - 1;
                    piece.style.left = (colIdx * cellWidth) + 'px';
                    piece.style.top = (rowIdx * cellHeight) + 'px';
                    piece.style.width = cellWidth + 'px';
                    piece.style.height = cellHeight + 'px';
                }
            });
        });

        // Запуск
        window.onload = initGame;
    </script>
</body>
</html>
